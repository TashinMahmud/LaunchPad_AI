# ─────────────────────────────────────────────────────────────────
# LaunchPad AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────

# ── AI Provider Selection ──────────────────────────────────────────
# Controls which AI engine processes business ideas.
# Accepted values: 'openai' | 'anthropic'
AI_PROVIDER=openai

# ── OpenAI (GPT-4o) ───────────────────────────────────────────────
# Required if AI_PROVIDER=openai
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Anthropic (Claude 3.5 Sonnet) ─────────────────────────────────
# Required if AI_PROVIDER=anthropic
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ── n8n Automation ─────────────────────────────────────────────────
# The webhook URL from your "Business Plan PDF Generator & Emailer" workflow.
# Found in n8n: open the Webhook node → copy the "Production URL".
# Leave blank for local development — PDF email delivery will be skipped.
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/business-plan-pdf

# ── Server ─────────────────────────────────────────────────────────
PORT=5000


